# ---------------------------------------------------------------
# Aoi Kaze: ortam değişkenleri. Bu dosyayı ".env.local" olarak kopyala.
# NEXT_PUBLIC_ ile başlayanlar BUILD sırasında koda gömülür; değiştirince yeniden build al.
# ---------------------------------------------------------------

# Sitenin canlı adresi (canonical, sitemap, RSS ve paylaşım görselleri için). Sonunda "/" olmasın.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Katalog verisi AniList'ten gelir. "false" yaparsan katalog kapanır ve sayfalar "veriye ulaşılamıyor" uyarısı gösterir.
ANILIST_ENABLED=true

# --- Veritabanı (PostgreSQL 16) ---
# Yerel geliştirme: "docker compose up -d db" ile başlatılır. Aşağıdaki değerler docker-compose.yml
# varsayılanlarıyla aynıdır; canlıda güçlü bir parola kullan ve .env.local'de POSTGRES_* değerlerini de ver.
# Geliştirme ve canlı aynı sağlayıcıyı (PostgreSQL) kullanır: migration'lar sağlayıcıya kilitlidir.
DATABASE_URL=postgresql://aoikaze:aoikaze_dev@localhost:5432/aoikaze
POSTGRES_USER=aoikaze
POSTGRES_PASSWORD=aoikaze_dev
POSTGRES_DB=aoikaze

# Docker kullanamıyorsan harici bir PostgreSQL de olur. Yukarıdaki DATABASE_URL satırını bunlardan biriyle değiştir:
#   Neon     : DATABASE_URL=postgresql://KULLANICI:PAROLA@ep-xxxx.REGION.aws.neon.tech/aoikaze?sslmode=require
#   Supabase : DATABASE_URL=postgresql://postgres.PROJE_KODU:PAROLA@aws-0-REGION.pooler.supabase.com:5432/postgres
# ÖNEMLİ: Migration'lar için "pooler" (PgBouncer, işlem modu / 6543 portu) adresi çalışmaz; Neon'da "Direct connection",
# Supabase'de doğrudan ya da "session pooler" (5432) adresini kullan. Parolayı asla depoya ekleme (.env.local git'e girmez).

# --- Giriş (Auth.js v5): GitHub + e-posta sihirli linki. Bir yöntem yalnızca env değişkenleri TAMAMSA etkin olur. ---
# Oturum imzalama anahtarı (zorunlu). Üret: npx auth secret   (ya da: openssl rand -base64 32)
AUTH_SECRET=
# Geliştirmede ve ters vekilin arkasında Host başlığına güven (canlıda kendi alan adın için AUTH_URL de verebilirsin).
AUTH_TRUST_HOST=true

# GitHub: github.com/settings/developers → New OAuth App
#   Homepage URL            : http://localhost:3000
#   Authorization callback  : http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# E-posta sihirli linki (Nodemailer). Geliştirmede Mailpit: docker compose up -d mailpit  →  gelen kutusu http://localhost:8025
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM="Aoi Kaze <no-reply@localhost>"

# Bu e-postalarla giriş yapan kullanıcı otomatik ADMIN olur (virgülle ayır, büyük/küçük harf fark etmez).
ADMIN_EMAILS=

# Discord (kodda hazır, ŞU AN KAPALI: iki değişken de boş bırakıldıkça sağlayıcı etkinleşmez)
# AUTH_DISCORD_ID=
# AUTH_DISCORD_SECRET=
# Discord sunucusu davet linki (https://...). Tanımsızsa menüde ve altbilgide hiç gösterilmez.
NEXT_PUBLIC_DISCORD_INVITE=

# --- İletişim sayfasındaki bağlantılar: yalnızca dolu olanlar görünür (https:// ile başlamalı) ---
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_TWITTER=
# Sayfada görünecek herkese açık e-posta adresi (form hedefinden ayrıdır)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- İletişim formu: en az biri tanımlı olmalı (ikisi birlikte de çalışır) ---
# 1) Webhook (n8n, Zapier, Make...). Mesaj JSON olarak POST edilir.
CONTACT_WEBHOOK_URL=
# İsteğe bağlı: "X-Webhook-Secret" başlığı olarak gönderilir, n8n tarafında doğrula.
CONTACT_WEBHOOK_SECRET=

# 2) Resend (e-posta). Gönderen alan adının Resend'de doğrulanmış olması gerekir.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- Analitik: Umami (çerezsiz). İkisi de doluysa yüklenir ---
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Blog yorumları: Giscus (GitHub Discussions). Dördü de doluysa görünür ---
# Değerleri https://giscus.app adresindeki ayar sihirbazı üretir.
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
